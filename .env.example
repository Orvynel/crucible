# Copy this file to .env.local and paste your own Nansen API key.
# Get one at https://app.nansen.ai/api
#
# The key is used in two SERVER-SIDE places and never reaches the browser:
#   1. the offline data scripts (scripts/build-dataset.ts)
#   2. the live API proxy (api/nansen.ts + the Vite dev middleware)
# In production, set NANSEN_API_KEY in your Vercel project's Environment Variables.
NANSEN_API_KEY=your_nansen_api_key_here

# Optional guards for the public live explorer:
# Pause live calls once the account's remaining credits drop below this floor.
NANSEN_MIN_CREDITS=300
# Set to 0/false/off to disable the live explorer entirely (kill switch).
NANSEN_LIVE_ENABLED=1

# Optional: server-side persistence so each visitor's last live search survives a page
# reload. Provision a free Redis store (Vercel → Storage → Upstash Redis, or Upstash
# directly) and set its REST credentials here / in Vercel. When unset, the explorer
# still works — searches just don't persist. Data is stored on the SERVER (never in the
# visitor's browser), keyed by a salted hash of their IP, and auto-expires after 7 days.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel's KV integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead — both work.)
# Optional random string that salts the per-visitor key hash.
CRUCIBLE_IP_SALT=
